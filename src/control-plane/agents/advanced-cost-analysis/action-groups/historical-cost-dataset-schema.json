{
  "openapi": "3.0.0",
  "info": {
    "title": "Historical Cost Dataset API",
    "version": "1.0.0",
    "description": "API to retrieve complete historical cost dataset from CostPerTenant table for cost analysis and dashboard generation"
  },
  "paths": {
    "/get-historical-cost-dataset": {
      "post": {
        "summary": "Get Historical Cost Dataset",
        "description": "Retrieves the entire historical cost dataset from CostPerTenant table with all tenant cost, revenue, margin, and margin percentage data",
        "operationId": "getHistoricalCostDataset",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully retrieved historical cost dataset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "historical_cost_dataset": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "tenant_id": {
                            "type": "string",
                            "description": "Unique tenant identifier"
                          },
                          "month": {
                            "type": "string",
                            "description": "Month in YYYY-MM format"
                          },
                          "tier": {
                            "type": "string",
                            "description": "Tenant tier (basic or premium)"
                          },
                          "cost": {
                            "type": "number",
                            "description": "Total cost for the tenant in that month"
                          },
                          "revenue": {
                            "type": "number",
                            "description": "Revenue generated from the tenant"
                          },
                          "margin": {
                            "type": "number",
                            "description": "Profit margin (revenue - cost)"
                          },
                          "margin_percentage": {
                            "type": "number",
                            "description": "Margin as percentage of revenue"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error retrieving dataset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
